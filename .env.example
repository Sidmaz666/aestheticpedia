# Aestheticpedia — environment configuration. Copy to .env.local for local development;
# on Vercel set these under Project → Settings → Environment Variables.
# Everything is optional; defaults are shown.

# Public URL of the site (canonical links, sitemap, OpenAPI, MCP, llms.txt, citations).
# If unset, Vercel's production domain (VERCEL_PROJECT_PRODUCTION_URL) or deployment URL is used,
# falling back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Site identity (titles, metadata, logo wordmark, exports, API and MCP server name).
NEXT_PUBLIC_SITE_NAME=Aestheticpedia
NEXT_PUBLIC_SITE_TAGLINE=The open encyclopedia of aesthetics
NEXT_PUBLIC_SITE_DESCRIPTION=

# Source repository — powers "Improve this record", contribution links, and the live project card
# (maintainer, stars, forks, issues) on the About page and footer. If unset, it is taken from
# Vercel's git metadata or the local `git remote`.
NEXT_PUBLIC_REPO_URL=https://github.com/sidmaz666/aestheticpedia
NEXT_PUBLIC_REPO_BRANCH=main

# Contact details used on the About page, footer and metadata. If the email is unset, the
# maintainer's public GitHub email (or the email on their latest commit) is used.
NEXT_PUBLIC_TWITTER_HANDLE=
NEXT_PUBLIC_CONTACT_EMAIL=sidmazumder8@gmail.com

# Optional: a GitHub token (no scopes needed) to lift the anonymous API rate limit for the project card.
GITHUB_TOKEN=

# Search engines. Only production deployments are indexed (VERCEL_ENV=production, or any
# production build off Vercel); preview and development deployments send noindex and a
# closed robots.txt. Force it either way with true/false.
NEXT_PUBLIC_ALLOW_INDEXING=
# Search-console ownership tokens (optional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Vercel sets these automatically (no action needed): VERCEL_ENV, VERCEL_URL,
# VERCEL_PROJECT_PRODUCTION_URL, VERCEL_GIT_REPO_OWNER, VERCEL_GIT_REPO_SLUG. They drive the
# site URL, indexing and the repository link when the variables above are left empty.
