{
  "name": "aestheticpedia",
  "version": "1.0.0",
  "private": true,
  "description": "Aestheticpedia — an open, contributor-built encyclopedia of the world's aesthetics, with a public API, MCP server and full data downloads.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "npm run data:build && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "data:build": "node scripts/data/build.ts",
    "data:normalize": "node scripts/data/normalize.ts",
    "data:images": "node scripts/data/images.ts",
    "data:links": "node scripts/data/check-links.ts",
    "data:validate": "node scripts/data/validate.ts",
    "data:new": "node scripts/data/new.ts",
    "data:import": "node scripts/data/import-wikidata.ts",
    "data:palette": "node scripts/data/palette.ts",
    "data:enrich": "node scripts/data/enrich-text.ts",
    "data:refresh": "npm run data:normalize && npm run data:images && npm run data:palette && npm run data:enrich && npm run data:links && npm run data:build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.5",
    "@huggingface/transformers": "^4.3.0",
    "@mlc-ai/web-llm": "^0.2.85",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-popover": "^1.1.23",
    "@tanstack/react-query": "^5.82.0",
    "d3-force": "^3.0.0",
    "d3-force-3d": "^3.0.6",
    "d3-hierarchy": "^3.1.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-audio-canvas": "^0.9.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.6",
    "three": "^0.186.0",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "overrides": {
    "react-audio-canvas": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
